# Porta publicada somente no loopback do VPS. O Cloudflared aponta para ela.
ALEXANDRIA_PORT=8080

# Porta interna do processo Alexandria. Normalmente pode permanecer 8080.
ALEXANDRIA_SERVER_PORT=8080

# Caminhos persistentes do deploy.
ALEXANDRIA_CONFIG_PATH=./config
ALEXANDRIA_BOOKS_PATH=/media/mateus/69B9-F5F5/Livros

# Autenticacao obrigatoria para acesso externo.
ALEXANDRIA_AUTH_ENABLED=true
ALEXANDRIA_AUTH_USERNAME=admin
ALEXANDRIA_AUTH_PASSWORD=troque-esta-senha
ALEXANDRIA_AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio

# IA opcional. Nunca coloque esta chave no frontend.
ALEXANDRIA_AI_ENABLED=false
ALEXANDRIA_GEMINI_API_KEY=
ALEXANDRIA_AI_MODEL=gemini-2.5-flash-lite
ALEXANDRIA_AI_TIMEOUT_SECONDS=20
